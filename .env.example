# Required for every SEC request. Use a monitored address.
SEC_USER_AGENT="I2 Systems msenkow@i2systems.com"

# PostgreSQL used by the ingestion jobs.
DATABASE_URL="postgres://sec_loom:sec_loom@127.0.0.1:5433/sec_loom"

# Cloudflare R2 S3-compatible credentials. Raw filings are immutable audit records.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sec-loom-raw"

# Optional but strongly recommended for higher OpenFIGI limits.
OPENFIGI_API_KEY=""

# Operational tuning.
SEC_MAX_REQUESTS_PER_SECOND="8"
INGEST_CONCURRENCY="4"
LOG_LEVEL="info"
