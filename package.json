{
  "name": "sec-loom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://mhsenkow.github.io/sec-loom/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/sec-loom/ tsc -b && BASE_PATH=/sec-loom/ vite build",
    "snapshot:export": "node scripts/export-dashboard-snapshot.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "db:migrate": "tsx ingest/cli.ts migrate",
    "ingest:bootstrap": "tsx ingest/cli.ts bootstrap",
    "ingest:daily": "tsx ingest/cli.ts daily",
    "ingest:resolve": "tsx ingest/cli.ts resolve",
    "ingest:recompute": "tsx ingest/cli.ts recompute",
    "ingest:sync": "tsx ingest/cli.ts sync",
    "ingest:backfill": "tsx ingest/cli.ts backfill",
    "worker:dev": "wrangler dev --config wrangler.local.jsonc",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "csv-parse": "^7.0.1",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "p-limit": "^7.3.1",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
